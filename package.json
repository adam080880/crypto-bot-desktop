{
  "name": "smc-trading-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "SMC/ICT trading assistant (Binance USDT-M, paper/testnet)",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "db:generate": "drizzle-kit generate",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "data:backfill": "electron-vite build --logLevel warn && cross-env ELECTRON_RUN_AS_NODE=1 electron out/main/backfill.js",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:win:portable": "electron-vite build && electron-builder --win zip --x64 --publish never -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.71.0",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "electron": "45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "productName": "SMC Trading Assistant"
}
