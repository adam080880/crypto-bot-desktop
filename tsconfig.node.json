{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/cli/**/*"
  ],
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "paths": { "@shared/*": ["src/shared/*"] }
  }
}
